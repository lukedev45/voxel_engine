{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build",
                "-DCMAKE_TOOLCHAIN_FILE=${env:VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "CMake Build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "dependsOn": "CMake Configure",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Run VoxelEngine",
            "type": "shell",
            "command": "${workspaceFolder}/build/VoxelEngine",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "CMake Build",
            "problemMatcher": []
        }
    ]
}
